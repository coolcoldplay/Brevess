{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brevess.local/schema/brevess-library-transfer-v1.json",
  "title": "BREVESS library transfer v1",
  "type": "object",
  "required": ["schema", "version", "kind", "generatedAt", "source", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "brevess-library-transfer-v1" },
    "version": { "const": 1 },
    "kind": { "enum": ["radar", "global-library", "combined"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "additionalProperties": true },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "fnv1a32" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radars": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/radar" } },
        "entries": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/globalEntry" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "radar" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["radars"] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "global-library" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["entries"] } } }
    }
  ],
  "$defs": {
    "radar": {
      "type": "object",
      "required": ["id", "name", "source", "query", "enabled", "intervalHours", "baselineDays", "editVersion", "revisions"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^radar-[A-Za-z0-9-]{1,120}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source": { "const": "pubmed" },
        "query": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "enabled": { "type": "boolean" },
        "intervalHours": { "type": "integer", "minimum": 0, "maximum": 720 },
        "baselineDays": { "enum": [1, 7, 30, 90] },
        "editVersion": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "revisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/radarRevision" } }
      }
    },
    "radarRevision": {
      "type": "object",
      "required": ["number", "query", "baselineDays", "articles", "warnings"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "query": { "type": "string" },
        "baselineDays": { "enum": [1, 7, 30, 90] },
        "createdAt": { "type": "string" },
        "windowStart": { "type": ["string", "null"] },
        "baselineAt": { "type": ["integer", "null"] },
        "lastSuccessAt": { "type": ["integer", "null"] },
        "lastAttemptAt": { "type": ["integer", "null"] },
        "nextRetryAt": { "type": ["integer", "null"] },
        "lastNewCount": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "queryTranslation": { "type": "string" },
        "error": { "type": ["object", "null"] },
        "articles": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/radarArticle" } }
      }
    },
    "radarArticle": {
      "type": "object",
      "required": ["id", "title", "read", "isBaseline"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{5,12}$" },
        "title": { "type": "string" },
        "journal": { "type": "string" },
        "createdDay": { "type": ["string", "null"] },
        "publicationDate": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "doi": { "type": "string" },
        "url": { "type": "string" },
        "firstSeenAt": { "type": "integer" },
        "isBaseline": { "type": "boolean" },
        "read": { "type": "boolean" },
        "abstractSections": { "type": "array" },
        "abstractStatus": { "type": "string" },
        "abstractCopyright": { "type": "string" },
        "abstractSource": { "type": "string" },
        "abstractError": { "type": ["object", "null"] },
        "abstractFetchedAt": { "type": "integer" },
        "abstractAttemptAt": { "type": "integer" }
      }
    },
    "globalEntry": {
      "type": "object",
      "required": ["title", "stableId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "stableId": { "type": "string" },
        "pmid": { "type": "string" },
        "doi": { "type": "string" },
        "title": { "type": "string" },
        "authors": { "type": "string" },
        "journal": { "type": "string" },
        "publicationDate": { "type": "string" },
        "year": { "type": "string" },
        "abstract": { "type": "string" },
        "url": { "type": "string" },
        "kind": { "enum": ["local", "radar"] },
        "sourceKind": { "enum": ["local", "radar", "mixed"] },
        "availability": { "enum": ["local", "metadata-only"] },
        "status": { "enum": ["complete", "partial", "missing", "unknown"] },
        "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "sourceDocuments": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/sourceDocument" } },
        "sources": {
          "type": "object",
          "required": ["local", "radar"],
          "additionalProperties": false,
          "properties": { "local": { "type": "boolean" }, "radar": { "type": "boolean" } }
        },
        "radarRead": { "type": "boolean" },
        "radarId": { "type": "string" },
        "radarRevision": { "type": "integer" },
        "workspaceId": { "type": "string" },
        "paperId": { "type": "string" },
        "imported": { "type": "boolean" },
        "inventoryOnly": { "type": "boolean" }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceId": { "type": "string" },
        "workspaceGeneration": { "type": "integer" },
        "documentId": { "type": "string" },
        "documentHash": { "type": "string" },
        "documentGeneration": { "type": "integer" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "canonicalUrl": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "offlineSnapshotStatus": { "type": "string" },
        "hasOfflineSnapshot": { "type": "boolean" },
        "lastSaveAttemptStatus": { "type": "string" },
        "availability": { "type": "string" },
        "mimeType": { "type": "string" },
        "paperId": { "type": "string" },
        "inventoryOnly": { "type": "boolean" }
      }
    }
  }
}
