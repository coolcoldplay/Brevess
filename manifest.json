{
  "manifest_version": 3,
  "name": "SCI论文逻辑关系高亮助手",
  "version": "2.4.0",
  "description": "支持正则模式与可扩展LLM全文识别的SCI论文逻辑关系高亮助手",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "offscreen",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "vendor/phosphor/Phosphor.woff2"],
      "matches": ["<all_urls>"]
    }
  ]
}
