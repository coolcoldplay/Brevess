{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "version_name": "1.0.1 R37 shared notes and model settings r4",
  "key": "",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "homepage_url": "https://github.com/coolcoldplay/Brevess",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "alarms",
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "offscreen",
    "sidePanel",
    "nativeMessaging",
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "core/i18n.js",
        "core/i18n-extension.js",
        "core/i18n-reader.js",
        "core/i18n-reader-extra.js",
        "core/i18n-system.js",
        "core/i18n-tools.js",
        "core/i18n-reader-patterns.js",
        "core/i18n-content.js",
        "core/page-tools.js",
        "semantic-find-launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": [
        "core/i18n.js",
        "core/i18n-extension.js",
        "core/i18n-reader.js",
        "core/i18n-reader-extra.js",
        "core/i18n-system.js",
        "core/i18n-tools.js",
        "core/i18n-reader-patterns.js",
        "core/i18n-content.js",
        "core/translation-source.js",
        "core/translation-checkpoint.js",
        "core/local-translator.js",
        "core/bilingual-translation-controller.js",
        "bilingual-translation-content.js"
      ],
      "css": [
        "bilingual-translation.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "action-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "semantic-find.css",
        "mechanism-drawing.css",
        "sharing/sharing.css",
        "vendor/phosphor/Phosphor.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
