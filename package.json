{
  "name": "brevess",
  "version": "1.0.1",
  "description": "AGPL browser extension for evidence-aware reading and full-text Q&A of scientific articles",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coolcoldplay/Brevess.git"
  },
  "homepage": "https://github.com/coolcoldplay/Brevess#readme",
  "bugs": {
    "url": "https://github.com/coolcoldplay/Brevess/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:foundation": "node --test tests/category-store.test.js tests/prompt-compiler.test.js tests/chunker.test.js tests/result-validator.test.js tests/cache-planner.test.js tests/article-extractor.test.js tests/analysis-pipeline.test.js",
    "test:edge-side-panel": "node scripts/verify-native-side-panel-extension.js",
    "test:edge-restart": "node scripts/verify-native-side-panel-restart.js",
    "test:science-snapshot": "node scripts/verify-saved-science-page.mjs",
    "test:codex-host": "node scripts/test-codex-native-host.mjs",
    "test:codex-host:exe": "node scripts/test-codex-native-host.mjs --exe --allow-auth-required",
    "test:pdf-host": "node scripts/test-pdf-figure-native-host.mjs --exe",
    "mcp:start": "node mcp/server.js --stdio-only",
    "mcp:serve": "node mcp/server.js --http-only --allow-write",
    "mcp:test": "node --test tests/mcp-server.test.cjs",
    "test:library-transfer": "node --test tests/library-transfer.test.js",
    "benchmark:article-chat": "node scripts/benchmark-article-chat.mjs",
    "benchmark:build39": "node scripts/benchmark-build39-prompts.mjs",
    "benchmark:zotero-regex": "node scripts/benchmark-zotero-mineru-regex.mjs",
    "benchmark:prompts": "node scripts/benchmark-production-prompts.mjs",
    "baseline:verify": "node scripts/generate-prompt-baseline.mjs --verify",
    "checkpoint2:corpus": "node scripts/build-checkpoint2-corpus.mjs",
    "checkpoint2:figures": "node scripts/refine-checkpoint2-figure-queue.mjs",
    "checkpoint2:prompts": "node scripts/generate-checkpoint2-prompt-artifacts.mjs",
    "checkpoint2:review-tools": "node scripts/generate-checkpoint2-review-tools.mjs",
    "assets:edge-store": "node scripts/generate-edge-store-assets.mjs",
    "screenshots:edge-store": "node scripts/capture-edge-store-screenshots.mjs",
    "qa:logic-map": "node scripts/capture-logic-map-qa.mjs",
    "build:pdf-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-pdffigures2.ps1",
    "build:pdf-fallback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-pdf-figure-fallback.ps1",
    "prepare:pdf-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-temurin-runtime.ps1",
    "build:codex-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-codex-native-host.ps1",
    "build:unpacked": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-unpacked-extension.ps1",
    "build:edge-store": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-edge-store-release.ps1"
  },
  "devDependencies": {
    "mermaid": "^11.12.2",
    "pdfjs-dist": "^5.4.624",
    "playwright": "^1.61.1",
    "postject": "^1.0.0-alpha.6"
  }
}
